  "pros": [
    {
      "text": "Two en-suite bedrooms on the ground floor",
      "weight": 3,
      "detail": "Bedroom 1 (5.3 × 4.0 m, shower en suite) and Bedroom 2 (5.3 × 4.7 m, bath en suite) come before the 'First Floor' heading in the agent's room list, next to a ground-floor WC with shower."
    },
    {
      "text": "3 acres beside Donadea Forest",
      "weight": 3,
      "detail": "Two paddocks, a ~600 m² sand arena, three loose boxes and a landscaped garden; Donadea Forest Park's trails are across the road."
    },
    {
      "text": "Big common rooms",
      "weight": 2,
      "detail": "10.7 × 5.1 m kitchen/living, 10.7 × 6.6 m games room with bar and sauna, 7.4 × 3.8 m stone dining room, plus a lounge, TV room and office."
    },
    {
      "text": "Four bathrooms plus a separate mews",
      "weight": 2,
      "detail": "Two en suites, a family bathroom and a shower WC in the house; the ~1,000 sq ft mews has its own kitchen and shower room for guests or letting (its two lofts are up a spiral stair)."
    },
    {
      "text": "Children's ED about 35 minutes away",
      "weight": 2,
      "detail": "CHI at Tallaght is about 25 km in a straight line (about 35 km by road via Clane and the N7); Crumlin is the alternative."
    },
    {
      "text": "Train to Dublin 9 km away",
      "weight": 2,
      "detail": "Kilcock has 10 weekday trains to Connolly (06:42–21:27, 43–62 min); Maynooth, 12 km away, has far more."
    },
    {
      "text": "Village primary 1.2 km; Clongowes 4.7 km",
      "weight": 1,
      "detail": "Staplestown NS (co-ed, ~110 pupils) is 1.2 km away; the house is in St Farnan's (Prosperous) catchment, and Clongowes Wood (fee-paying) is 4.7 km."
    },
    {
      "text": "Full fibre at the address",
      "weight": 1,
      "detail": "BuyerIQ shows 387 Mb full fibre for this Eircode."
    }
  ],
  "cons": [
    {
      "text": "€1,175,000, well over the brief",
      "weight": 3,
      "detail": "€3,013/m², about 2.35 times the €500k line, with €13,500 stamp duty. It has been listed for 121 days (since 27 Jun) with no price change found, which gives some room to negotiate."
    },
    {
      "text": "BER D1, oil heating, 390 m² to heat",
      "weight": 3,
      "detail": "238.59 kWh/m²/yr, about 93,000 kWh/yr modelled. As a rough guess, oil costs €7–10k a year and a heat-pump and insulation retrofit costs €60–100k before grants."
    },
    {
      "text": "A lot to maintain",
      "weight": 2,
      "detail": "1850s stone house, 2002 extension, mews, stables, arena, paddocks, hot tub, sauna and bar: years of upkeep and running costs before any change."
    },
    {
      "text": "Water and sewage not stated",
      "weight": 2,
      "detail": "Neither the listing nor the features mention them; a rural site like this usually has a septic tank or treatment unit, and possibly a well."
    },
    {
      "text": "Local school quality unverified",
      "weight": 1,
      "detail": "No inspection or progression figures were found for Staplestown NS, St Farnan's or Scoil Mhuire Clane, and the Clane–Prosperous area is oversubscribed for first-year places; only Clongowes (fee-paying) has a strong record."
    },
    {
      "text": "Flood zone 0.3 km away",
      "weight": 1,
      "detail": "BuyerIQ (OPW NIFM, indicative) maps a river flood zone about 0.3 km from the address; get a flood-cover quote."
    },
    {
      "text": "Front wall on the road, farmyard nearby",
      "weight": 1,
      "detail": "From above, the house fronts a local road with a row of four or five houses alongside to the west and a farmyard about 200 m west; fields to the south and the forest to the north."
    }
  ],
