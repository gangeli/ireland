  "pros": [
    {
      "text": "€370k, well under €500k",
      "weight": 3,
      "detail": "€1,568/m². Stamp duty about €3,700, leaving room in the budget for the refurbishment."
    },
    {
      "text": "Direct train a 10-minute walk away",
      "weight": 3,
      "detail": "The listing puts Monasterevin station about 800 m away; roughly 25 trains a day, 43–59 minutes to Dublin Heuston."
    },
    {
      "text": "Primary school for boys 310 m away",
      "weight": 2,
      "detail": "St Evin's (60 m) takes boys only in junior and senior infants, so the boys would go to St Peter's Boys' NS (310 m, 239 pupils). St John's (70 m) is a 44-pupil Church of Ireland school. St Paul's secondary has moved to Moore Abbey, about 1 km, and sent 60% to third level in 2025."
    },
    {
      "text": "Right size: 236 m²",
      "weight": 2,
      "detail": "About 2,525 sq ft over two floors, inside the 140–280 m² target."
    },
    {
      "text": "Walk to everything in town",
      "weight": 2,
      "detail": "Town-centre address on Drogheda Street: SuperValu, pubs, pharmacy and the canal on foot."
    },
    {
      "text": "Period character",
      "weight": 1,
      "detail": "Mid-Victorian, full-height canted bay, marble fireplaces in five rooms, shutters, slate-roofed outbuilding and garage."
    },
    {
      "text": "Mains water and drainage; grant potential",
      "weight": 1,
      "detail": "No well or septic to worry about. Vacant 2+ years, so it may qualify for the Vacant Property Refurbishment Grant (up to €50k)."
    }
  ],
  "cons": [
    {
      "text": "No ground-floor bedroom yet",
      "weight": 3,
      "detail": "All four bedrooms are upstairs. The ground-floor family room (4.26 × 4.23 m) or living room (4.25 × 4.08 m) could become one; there is already a ground-floor shower room (4.24 × 3.76 m)."
    },
    {
      "text": "Needs full refurbishment",
      "weight": 3,
      "detail": "Vacant for over two years, BER-exempt, solid-fuel stoves only. A rough €150–250k for heating, insulation, wiring, kitchen and baths; get a survey."
    },
    {
      "text": "0.8 acres, short of the 1-acre ideal",
      "weight": 2,
      "detail": "Extensive gardens for a town house, but under the acre wanted for two vizslas. Check boundaries and fencing."
    },
    {
      "text": "Hemmed in by town",
      "weight": 1,
      "detail": "Aerials show a big, wooded garden, but terraces and estates all round and a large building site next door (ask what's going up). Private, but no open land beyond the walls. Fine for the 'space' brief only inside the walls."
    },
    {
      "text": "Possible conservation constraints",
      "weight": 1,
      "detail": "Drogheda Street has several buildings on the National Inventory of Architectural Heritage; check whether the house is a protected structure before planning changes."
    },
    {
      "text": "Small kitchen",
      "weight": 1,
      "detail": "Kitchen is 4.25 × 2.43 m; expect to rework the layout with the dining room."
    },
    {
      "text": "ED about 25–30 minutes",
      "weight": 1,
      "detail": "Midland Regional Hospital Portlaoise takes all ages. Naas General is 16+ only, so children can't go there."
    },
    {
      "text": "Local secondary is middling",
      "weight": 1,
      "detail": "St Paul's (mixed, DEIS) sent 60% to third level in 2025; Ardscoil Rath Iomgháin in Rathangan (81%) is about 11 km."
    }
  ],
